# Copy to .env.local. Never commit real credentials.
# Public browser configuration (Supabase publishable/anon key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8787
VITE_DEMO_MODE=true
VITE_BASE_PATH=/
# Trusted API and Worker only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:5173
PORT=8787
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
SANDBOX_IMAGE=atoms-sandbox:local
MAX_RUN_STEPS=32
RUN_TIMEOUT_MS=300000
# Set false for a production deployment.
ALLOW_DEMO=true

