# Copy to .env.local. Never commit real credentials.
# Public browser configuration (Supabase publishable/anon key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8787
VITE_DEMO_MODE=true
VITE_BASE_PATH=/
# Trusted API and Worker only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:5173
PORT=8787
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Project source/checkpoints/versions stay local; default is ~/.local/share/atoms-workbench.
PROJECT_FILES_ROOT=
SANDBOX_IMAGE=atoms-sandbox:local
# Optional base-image sources for Docker builds (see docs/docker-network.md).
SANDBOX_NODE_IMAGE=node:24-alpine
SERVER_NODE_IMAGE=node:24-bookworm-slim
DOCKER_CLI_IMAGE=docker:29-cli
WEB_RUNTIME_IMAGE=caddy:2-alpine
MAX_RUN_STEPS=128
RUN_TIMEOUT_MS=1800000
MAX_BUILD_ATTEMPTS=10
BUILD_TIMEOUT_MS=300000
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=512
SANDBOX_WORK_MB=1024
SANDBOX_TMP_MB=256
MAX_PROJECT_FILES=200
MAX_SOURCE_FILE_CHARS=500000
MAX_LOCAL_ARTIFACT_BYTES=134217728
MAX_PREVIEW_JS_BYTES=20971520
MAX_PREVIEW_CSS_BYTES=5242880
API_REQUESTS_PER_MINUTE=300
API_BODY_LIMIT_BYTES=2097152
# Set false for a production deployment.
ALLOW_DEMO=true
