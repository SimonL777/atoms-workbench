{
  "name": "atoms-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web 'npm run dev -w apps/server' 'npm run dev -w apps/web'",
    "worker": "npm run worker -w apps/server",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test apps/server/test/*.test.ts",
    "test:e2e": "playwright test",
    "test:auth": "playwright test --config=playwright.auth.config.ts",
    "test:live": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test --config=playwright.live.config.ts",
    "prepare:auth": "node --env-file-if-exists=.env.local scripts/prepare-auth-fixture.mjs",
    "test:database": "node scripts/test-database.mjs",
    "verify:online": "node scripts/verify-online.mjs",
    "verify:secrets": "node scripts/check-public-files.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
